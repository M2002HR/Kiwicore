APP_ENV=development
SERVICE_NAME=kiwi-bridge
LOG_LEVEL=INFO
LOG_FORMAT=json
HTTPX_LOG_LEVEL=WARNING
TZ=Asia/Tehran

TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_TOKEN
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_FILE_BASE_URL=https://api.telegram.org/file
TELEGRAM_POLL_TIMEOUT_SEC=30
TELEGRAM_ALLOWED_UPDATES=["channel_post","edited_channel_post"]

BALE_BOT_TOKEN=REPLACE_ME_BALE_TOKEN
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_FILE_BASE_URL=https://tapi.bale.ai/file
HTTP_TRUST_ENV=false
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost

BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_ALL_PROXY=
BUILD_NO_PROXY=

CHANNELS_CONFIG_PATH=./config/channels.json
SCRIPTS_DIR=./scripts/channel_scripts
GAURD_SCRIPTS_DIR=./scripts/gaurd_scrpts
STORAGE_DIR=./app_data
STATE_PATH=./app_data/state.json
DEFAULT_MAX_MESSAGE_MB=50
SCRIPT_TIMEOUT_SEC=120
GAURD_SCRIPT_TIMEOUT_SEC=60
POLL_IDLE_SLEEP_SEC=1
POLL_ERROR_SLEEP_SEC=5
LOG_CHANNEL_TARGET=
MEDIA_GROUP_WAIT_SEC=1.4
ADMIN_BOT_ENABLED=true
ADMIN_USERS_CONFIG_PATH=./config/admin_users.json
ADMIN_SESSIONS_PATH=./app_data/admin_sessions.json

GUARD_AI_ENABLED=true
GUARD_AI_ENDPOINT=http://gemini_server:8000/proxy/gemini
GUARD_AI_MODEL=gemini-2.5-flash
GUARD_AI_TIMEOUT_SEC=30
GUARD_AI_FAIL_OPEN=true
SCRIPT_CLEAN_AI_ENABLED=true
SCRIPT_CLEAN_AI_ENDPOINT=
SCRIPT_CLEAN_AI_MODEL=
SCRIPT_CLEAN_AI_TIMEOUT_SEC=20
SCRIPT_CLEAN_AI_FAIL_OPEN=true

GEMINI_SERVER_PORT=18000

# Gemini submodule runtime config (from gemini_server/.env.example)
APP_CONFIG_FILE=config/config.yml
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_REQUEST_TIMEOUT_SEC=120
APP_ENABLE_DOCS=false
APP_DOCS_URL=/docs
APP_REDOC_URL=/redoc
APP_OPENAPI_URL=/openapi.json
APP_RELOAD=false

PROXY_MODE=gemini_direct
PROXY_TRUST_ENV_PROXY=false
PROXY_RETRY_ON_429=true
PROXY_MAX_RETRIES_PER_KEY=2
PROXY_COOLOFF_SEC=30
PROXY_MIN_INTERVAL_SEC=0

GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=REPLACE_ME_GEMINI_API_KEY
GEMINI_DEFAULT_REQUEST_JSON={"generationConfig":{"temperature":0.3}}

CLOUDFLARE_WORKER_BASE_URLS=https://your-worker-subdomain.workers.dev
CLOUDFLARE_WORKER_ROUTE_PREFIX=/gemini
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_AUTH_HEADER_NAME=x-worker-auth
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
CLOUDFLARE_PASS_TRACE_HEADERS=true

ADMIN_ENABLED=true
ADMIN_REQUIRE_AUTH=false
ADMIN_TOKEN=
ADMIN_HEADER_NAME=x-admin-token
ADMIN_MODELS_CACHE_TTL_SEC=300
ADMIN_MAX_RECENT_REQUESTS=2000
ADMIN_MAX_INCIDENTS=500

DEV_WATCH_COMMAND=
DEV_WATCH_PATHS=src,scripts,config,.env,pyproject.toml,requirements.txt
DEV_WATCH_IGNORE_DIRS=.git,.venv,.pytest_cache,__pycache__,app_data,app_tmp
DEV_WATCH_DEBOUNCE_MS=700
DEV_WATCH_POLL_DELAY_MS=300
DEV_WATCH_FORCE_POLLING=
DEV_WATCH_TERM_TIMEOUT_SEC=10
DEV_WATCH_RUST_TIMEOUT_MS=1000
